# =============================================================================
# Environment template — copy to .env.local
# Secrets: use placeholders here; never commit real values.
# After copying locally, treat all secrets as TO BE ROTATED if exposed to AI agents.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Optional: GET /api/health/db (Bearer or x-db-health-secret header)
DB_HEALTH_CHECK_SECRET="generate-with-openssl-rand-base64-32"

# --- Auth (NextAuth) ---
# Must match the public site URL (e.g. https://dev.samanaffa.com on preview)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# --- Admin ---
ADMIN_JWT_SECRET="your-admin-jwt-secret"
ADMIN_EMAIL="admin@samanaffa.com"
ADMIN_PASSWORD="secure-admin-password"

# --- OTP / SMS (BulkSMS) — ONE auth method only ---
# BULKSMS_TOKEN="token-id:token-secret"
BULKSMS_USERNAME="your-bulksms-username"
BULKSMS_PASSWORD="your-bulksms-password"
# Local + Vercel Preview (scope MOCK_OTP to Preview in dashboard; never Production)
MOCK_OTP="true"

# --- Email (Nodemailer) ---
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="your-smtp-user"
EMAIL_PASS="your-smtp-password"
EMAIL_SENDER="Sama Naffa <noreply@samanaffa.com>"

# --- KYC uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Didit KYC ---
DIDIT_API_KEY="your-didit-api-key"
DIDIT_WORKFLOW_ID="your-didit-workflow-uuid"
DIDIT_WEBHOOK_SECRET="your-didit-webhook-secret"
# Dev/test only: auto-approve KYC without Didit (ignored in production)
# DIDIT_KYC_BYPASS=true
# Public site URL (Didit KYC callback, etc.). On preview use https://dev.samanaffa.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- App environment (optional; drives InTouch test vs prod) ---
# NEXT_PUBLIC_APP_ENV=development

# --- InTouch — test/sandbox (preview / local) ---
INTOUCH_TEST_API_KEY="your-test-api-key"
INTOUCH_TEST_MERCHANT_ID="your-test-merchant-id"
NEXT_PUBLIC_INTOUCH_TEST_MERCHANT_ID="your-test-merchant-id"
NEXT_PUBLIC_INTOUCH_TEST_DOMAIN="dev.example.com"
INTOUCH_BASIC_AUTH_USERNAME_TEST="your-test-webhook-username"
INTOUCH_BASIC_AUTH_PASSWORD_TEST="your-test-webhook-password"
INTOUCH_ALLOW_UNSIGNED_CALLBACKS="true"

# --- InTouch — production ---
INTOUCH_API_KEY="your-production-api-key"
INTOUCH_MERCHANT_ID="your-production-merchant-id"
NEXT_PUBLIC_INTOUCH_MERCHANT_ID="your-production-merchant-id"
NEXT_PUBLIC_INTOUCH_DOMAIN="example.com"
INTOUCH_DOMAIN="example.com"
INTOUCH_BASIC_AUTH_USERNAME="your-webhook-username"
INTOUCH_BASIC_AUTH_PASSWORD="your-webhook-password"
INTOUCH_WEBHOOK_SECRET="your-webhook-secret"
# INTOUCH_ALLOW_UNSIGNED_CALLBACKS=false

# --- InTouch / payment hardening (optional; defaults in code) ---
# PAYMENT_RATE_LIMIT_WINDOW=900000
# PAYMENT_RATE_LIMIT_MAX_REQUESTS=10
# PAYMENT_MAX_AMOUNT=10000000
# PAYMENT_MIN_AMOUNT=100
# PAYMENT_MAX_PAYLOAD_SIZE=10240
# PAYMENT_IDEMPOTENCY_TTL=86400000

# --- Rate limits (optional; defaults in src/lib/rate-limit.ts) ---
# ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# OTP_RATE_LIMIT_MAX_ATTEMPTS=3

# --- Investment minimums (optional; defaults in code) ---
# NEXT_PUBLIC_APE_MIN_INVESTMENT_CFA=10000
# NEXT_PUBLIC_PEE_MIN_INVESTMENT_CFA=30000
# NEXT_PUBLIC_PEE_INVESTMENT_INCREMENT_CFA=5000

# --- Maintenance (optional) ---
# NEXT_PUBLIC_MAINTENANCE_MODE=false
