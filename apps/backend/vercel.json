{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "cd ../.. && bun install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**/*"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ../../packages/shared"
}
